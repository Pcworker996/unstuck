# Firebase web-app configuration. These are public browser identifiers.
NEXT_PUBLIC_FIREBASE_API_KEY=example-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=example.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=example-project
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:example

# Server-side Firebase Admin configuration.
FIREBASE_PROJECT_ID=example-project

# Ticket 2 Vertex AI / Genkit configuration.
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_GEMINI_MODEL_ID=gemini-3.5-flash

# Required private temporary PDF bucket and bounded daily use.
GOOGLE_TEMP_ARTIFACT_BUCKET=example-project-temporary-pdfs
GOOGLE_DAILY_MODEL_ACCOUNT_LIMIT=100
GOOGLE_DAILY_MODEL_GLOBAL_LIMIT=1000
GOOGLE_DAILY_ARTIFACT_ACCOUNT_LIMIT=10
GOOGLE_DAILY_ARTIFACT_GLOBAL_LIMIT=100
